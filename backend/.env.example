# Copia este fichero a .env y pon valores reales. .env NO se sube a Git.
DB_URL=jdbc:postgresql://localhost:5432/pangestion
DB_USER=pangestion
DB_PASSWORD=cambia-esta-contrasena
# Minimo 32 caracteres aleatorios (por ejemplo: openssl rand -base64 48)
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria-de-32-o-mas-caracteres
# true solo si quieres cargar los datos y usuarios de ejemplo
SEED_DATA=false
# Cifrado de datos personales: 32 bytes en Base64 (openssl rand -base64 32). Guardala: sin ella no se leen esos datos
ENCRYPTION_KEY=cambia-esto-por-32-bytes-en-base64
