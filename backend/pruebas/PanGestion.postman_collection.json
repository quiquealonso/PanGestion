        {
          "name": "Primera franja libre de mañana",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/company/slots?date={{pickupDate}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "company",
                "slots"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{pickupDate}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(); d.setDate(d.getDate() + 1);",
                  "pm.collectionVariables.set('pickupDate', d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const free = pm.response.json().find(s => s.available);",
                  "pm.test('hay alguna franja libre', () => pm.expect(free).to.exist);",
                  "pm.collectionVariables.set('pickupTime', free.time);"
                ]
              }
            }
          ]
        },
        {
          "name": "Pedido anidado del cliente (sin el ingrediente): 201 + Location",
