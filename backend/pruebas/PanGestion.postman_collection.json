              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "{{customerId}}",
                "orders"
              ]
            },
            "description": "Creación anidada (S9): la ruta decide el cliente; Location lleva al detalle canónico /api/orders/{id}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupDate\": \"{{pickupDate}}\",\n  \"pickupTime\": \"{{pickupTime}}\",\n  \"notes\": \"Pedido de la colección\",\n  \"lines\": [\n    {\n      \"productId\": {{productId}},\n      \"quantity\": 2,\n      \"removedIngredientIds\": [\n        {{ingredientId}}\n      ]\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201', () => pm.response.to.have.status(201));",
                  "pm.test('Location apunta al detalle', () => pm.expect(pm.response.headers.get('Location')).to.match(/\\/api\\/orders\\/\\d+$/));",
                  "pm.collectionVariables.set('orderId', pm.response.json().id);",
                  "const o = pm.response.json();",
                  "pm.test('pendiente, total 5 y con el ingrediente quitado', () => {",
                  "  pm.expect(o.status).to.eql('PENDIENTE');",
                  "  pm.expect(o.total).to.eql(5);",
                  "  pm.expect(o.lines[0].removedIngredients).to.have.length(1);",
                  "  pm.expect(o.customerId).to.eql(pm.collectionVariables.get('customerId'));",
                  "});"
                ]
              }
            }
          ]
        },
