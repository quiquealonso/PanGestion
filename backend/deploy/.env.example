# Copia este fichero a .env en la VM y pon valores reales. .env NO se sube a Git.
DB_USER=pangestion
DB_PASSWORD=cambia-esta-contrasena
# Minimo 32 caracteres aleatorios (por ejemplo: openssl rand -base64 48)
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria-de-32-o-mas-caracteres
# true solo si quieres cargar los datos y usuarios de ejemplo (contrasenas debiles)
SEED_DATA=false
# Cifrado de datos personales: 32 bytes en Base64 (openssl rand -base64 32). Guardala: sin ella no se leen esos datos
ENCRYPTION_KEY=cambia-esto-por-32-bytes-en-base64
# Emails a clientes (confirmar la cuenta). Sin SMTP_HOST las cuentas se activan sin confirmar el email.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USERNAME=tu correo, SMTP_PASSWORD=contrasena de aplicacion (16 letras,
# https://myaccount.google.com/apppasswords, necesita verificacion en 2 pasos), MAIL_FROM="PanGestion <tu correo>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# Dominio publico de la API (sin dominio propio: <ip-con-guiones>.sslip.io)
API_DOMAIN=34-175-204-112.sslip.io
# Origen del frontend (GitHub Pages), separados por comas si hay varios
CORS_ORIGINS=https://quiquealonso.github.io
